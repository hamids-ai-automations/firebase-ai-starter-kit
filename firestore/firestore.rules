rules_version = '2';

// Spark-plan edition: there are no Cloud Functions, so these rules are the only
// backend authorisation layer. Every collection is either owner-scoped or
// write-validated; nothing is world-readable and nothing is client-deletable
// except a user's own conversations/messages.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isNonEmptyString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function nonNegativeInt(value) {
      return value is int && value >= 0;
    }

    // ---------------------------------------------------------------------
    // users/{uid} — the profile document
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if isOwner(uid);

      allow create: if isOwner(uid)
        && incoming().keys().hasOnly([
          'email', 'displayName', 'bio', 'role', 'preferences', 'createdAt', 'updatedAt'
        ])
        && incoming().role == 'user'
        && isShortString(incoming().email, 320)
        && isShortString(incoming().displayName, 80)
        && isShortString(incoming().bio, 280)
        && incoming().preferences is map
        && incoming().preferences.keys().size() <= 32;

      // Only the three editable fields may ever change; role and email are frozen.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'bio', 'preferences', 'updatedAt'])
        && isShortString(incoming().displayName, 80)
        && isShortString(incoming().bio, 280)
        && incoming().preferences is map
        && incoming().preferences.keys().size() <= 32;

      allow delete: if false;

      // -------------------------------------------------------------------
      // users/{uid}/conversations/{cid} — one document per chat thread
      // -------------------------------------------------------------------
      match /conversations/{cid} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);

        allow create: if isOwner(uid)
          && incoming().keys().hasOnly([
            'title', 'model', 'messageCount', 'lastMessagePreview', 'createdAt', 'updatedAt'
          ])
          && isNonEmptyString(incoming().title, 120)
          && isShortString(incoming().model, 64)
          && incoming().messageCount == 0
          && isShortString(incoming().lastMessagePreview, 140);

        // messageCount may only grow (the client appends two messages per turn).
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'messageCount', 'lastMessagePreview', 'updatedAt'])
          && isNonEmptyString(incoming().title, 120)
          && nonNegativeInt(incoming().messageCount)
          && incoming().messageCount >= resource.data.messageCount
          && isShortString(incoming().lastMessagePreview, 140);

        allow delete: if isOwner(uid);

        // ---------------------------------------------------------------
        // users/{uid}/conversations/{cid}/messages/{messageId}
        // ---------------------------------------------------------------
        match /messages/{messageId} {
          allow get: if isOwner(uid);
          allow list: if isOwner(uid);

          allow create: if isOwner(uid)
            && incoming().keys().hasOnly(['role', 'text', 'model', 'tokens', 'createdAt'])
            && incoming().role in ['user', 'model']
            && isNonEmptyString(incoming().text, 8000)
            && (incoming().role == 'user' || isShortString(incoming().model, 64))
            && (!('tokens' in incoming()) || nonNegativeInt(incoming().tokens));

          // Messages are append-only: no editing history after the fact.
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }

      // -------------------------------------------------------------------
      // users/{uid}/usage_events/{eventId} — one document per AI call
      // Replaces the server-side counters of the Functions build.
      // -------------------------------------------------------------------
      match /usage_events/{eventId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);

        allow create: if isOwner(uid)
          && incoming().keys().hasOnly([
            'endpoint', 'model', 'promptTokens', 'candidateTokens', 'totalTokens', 'createdAt'
          ])
          && incoming().endpoint in ['aiGenerateText', 'aiGenerateStructured', 'aiChat']
          && isShortString(incoming().model, 64)
          && nonNegativeInt(incoming().promptTokens)
          && nonNegativeInt(incoming().candidateTokens)
          && nonNegativeInt(incoming().totalTokens);

        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // secure_echo/{id} — top-level collection that proves input validation
    // can be enforced by rules alone, with no trusted server in the loop.
    // ---------------------------------------------------------------------
    match /secure_echo/{echoId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;

      // No client-side listing: documents are only fetched by id right after
      // creation, so a blanket list rule would leak other users' echoes.
      allow list: if false;

      allow create: if signedIn()
        && incoming().keys().hasOnly(['message', 'priority', 'uid', 'createdAt'])
        && incoming().uid == request.auth.uid
        && isNonEmptyString(incoming().message, 500)
        && incoming().priority in ['low', 'medium', 'high'];

      allow update, delete: if false;
    }

    // Rate-limit buckets were server-owned in the Functions build and are now
    // dead weight; keep them unreadable and unwritable for clarity.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
