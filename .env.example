# ---------------------------------------------------------------------------
# Firebase AI Starter Kit - example environment file
# Copy to .env and fill in your own values. Never commit real credentials.
# Spark plan: the web app never calls Cloud Functions, so there are no
# VITE_FUNCTIONS_* variables anymore.
# ---------------------------------------------------------------------------

# --- Web client (Vite) -----------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini model for the browser-side REST calls. The user supplies the API key in
# the Setup tab; it is stored in sessionStorage and never in a .env file.
VITE_GEMINI_MODEL=gemini-2.5-flash

# Use the Firebase Emulator Suite (true) or real Firebase services (false).
# Only Auth and Firestore emulators are wired up in this build.
VITE_USE_EMULATORS=true
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Legacy Cloud Functions (kept in the repo, NOT deployed on Spark) ------
# Only needed if you choose to deploy functions/ later with a Blaze plan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MOCK_MODE=false
AI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
