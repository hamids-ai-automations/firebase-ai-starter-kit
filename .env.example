# ---------------------------------------------------------------------------
# Firebase AI Starter Kit - example environment file
# Copy to .env and fill in your own values. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Web client (Vite) -----------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-central1
VITE_APPCHECK_SITE_KEY=

# Use the Firebase Emulator Suite (true) or real Firebase services (false)
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1

# --- Cloud Functions (server-side only) ------------------------------------
# Set with:  firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Mock the model locally (emulator only) so no API calls are billed
AI_MOCK_MODE=false
AI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
