{
  "name": "firebase-ai-starter-kit-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:unit": "vitest run test/unit",
    "test:rules": "vitest run test/rules",
    "test:live": "vitest run test/live",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.1"
  }
}
