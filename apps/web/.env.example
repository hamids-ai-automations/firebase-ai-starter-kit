# Copy to apps/web/.env.local and fill in from
# Firebase console > Project settings > Your apps > Web app config.
# These values are public by design (they ship in the browser bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini model used by the browser-side REST calls.
# The API key is NOT an env var in this build: each user pastes their own key in
# the Setup tab and it is kept in sessionStorage only.
VITE_GEMINI_MODEL=gemini-2.5-flash

# Local development against the Firebase Emulator Suite (Auth + Firestore only).
# There is no Functions emulator in the Spark build.
VITE_USE_EMULATORS=false
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

VITE_APP_VERSION=0.1.0
